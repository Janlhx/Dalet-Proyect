# ==============================================================================
# Dalet — Variables de Entorno de Ejemplo
# Copia este archivo como '.env' y completa con tus credenciales reales.
# ==============================================================================

# --- Discord & Core ---
DISCORD_TOKEN=tu_token_de_discord_aqui

# --- Modelos de Inteligencia Artificial ---
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
OPENROUTER_API_KEY=tu_api_key_de_openrouter_opcional_aqui

# --- Base de Datos Turso (LibSQL Cloud) ---
TURSO_DATABASE_URL=libsql://tu-db-tu-usuario.turso.io
TURSO_AUTH_TOKEN=tu_token_de_autenticacion_de_turso

# --- osu! API v2 (Opcional para comandos de osu!) ---
OSU_CLIENT_ID=0
OSU_CLIENT_SECRET=tu_client_secret_de_osu_aqui

# --- Seguridad Web & Dashboard ---
# Token opcional para proteger /dashboard, /api/feedbacks y /api/telemetry.
# Si está vacío o no se define, funciona en modo desarrollo (abierto sin clave).
DASHBOARD_SECRET=clave_secreta_para_proteger_el_dashboard_en_render
